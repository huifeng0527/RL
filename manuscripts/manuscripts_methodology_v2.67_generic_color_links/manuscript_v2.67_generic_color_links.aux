\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dual-stream policy architecture with auxiliary dynamics prediction. The spatial branch encodes the geometric state, the temporal branch encodes recent interaction history with a recurrent module, and the fused representation supports the policy head, value head, and auxiliary prediction head.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:architecture}{{2}{5}{Dual-stream policy architecture with auxiliary dynamics prediction. The spatial branch encodes the geometric state, the temporal branch encodes recent interaction history with a recurrent module, and the fused representation supports the policy head, value head, and auxiliary prediction head}{figure.2}{}}
\newlabel{eq:total_loss}{{9}{5}{Dual-Stream Encoder with Auxiliary Dynamics Prediction}{equation.3.9}{}}
